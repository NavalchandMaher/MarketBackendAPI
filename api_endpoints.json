{
  "info": {
    "name": "Market AI V3 - Backend API",
    "version": "3.0.0",
    "description": "Complete API documentation for Market AI Trading Platform V3",
    "baseUrl": "http://localhost:8000",
    "baseUrlProduction": "https://your-production-api.com",
    "authentication": "Bearer Token (JWT)",
    "lastUpdated": "2026-07-09"
  },
  "endpoints": {
    "auth": [
      {
        "name": "Register User",
        "method": "POST",
        "path": "/auth/register",
        "statusCode": 201,
        "description": "Create a new user account",
        "requiresAuth": false,
        "requestBody": {
          "full_name": "string (required)",
          "email": "string (required, valid email)",
          "password": "string (required)",
          "mobile_number": "string (optional)",
          "role": "string (optional, default: Trader)",
          "default_symbol": "string (optional, default: BTCUSDT)",
          "default_timeframe": "string (optional, default: 5m)",
          "theme": "string (optional, default: dark)",
          "notification_settings": "object (optional)"
        }
      },
      {
        "name": "Login User",
        "method": "POST",
        "path": "/auth/login",
        "statusCode": 200,
        "description": "Authenticate and get JWT tokens",
        "requiresAuth": false,
        "requestBody": {
          "email": "string (required)",
          "password": "string (required)"
        }
      },
      {
        "name": "Refresh Token",
        "method": "POST",
        "path": "/auth/refresh",
        "statusCode": 200,
        "description": "Get new access token using refresh token",
        "requiresAuth": false,
        "requestBody": {
          "refresh_token": "string (required)"
        }
      },
      {
        "name": "Logout",
        "method": "POST",
        "path": "/auth/logout",
        "statusCode": 200,
        "description": "Logout current user",
        "requiresAuth": true,
        "requestBody": {}
      },
      {
        "name": "Forgot Password",
        "method": "POST",
        "path": "/auth/forgot-password",
        "statusCode": 200,
        "description": "Request password reset",
        "requiresAuth": false,
        "requestBody": {
          "email": "string (required)"
        }
      },
      {
        "name": "Reset Password",
        "method": "POST",
        "path": "/auth/reset-password",
        "statusCode": 200,
        "description": "Reset password with token",
        "requiresAuth": false,
        "requestBody": {
          "token": "string (required)",
          "new_password": "string (required)"
        }
      },
      {
        "name": "Change Password",
        "method": "POST",
        "path": "/auth/change-password",
        "statusCode": 200,
        "description": "Change password while logged in",
        "requiresAuth": true,
        "requestBody": {
          "current_password": "string (required)",
          "new_password": "string (required)"
        }
      }
    ],
    "users": [
      {
        "name": "Get Current User",
        "method": "GET",
        "path": "/users/me",
        "statusCode": 200,
        "description": "Get authenticated user profile",
        "requiresAuth": true,
        "queryParameters": []
      },
      {
        "name": "Update User Profile",
        "method": "PUT",
        "path": "/users/me",
        "statusCode": 200,
        "description": "Update user profile",
        "requiresAuth": true,
        "requestBody": {
          "full_name": "string (optional)",
          "mobile_number": "string (optional)",
          "default_symbol": "string (optional)",
          "default_timeframe": "string (optional)",
          "theme": "string (optional)",
          "notification_settings": "object (optional)"
        }
      },
      {
        "name": "List All Users",
        "method": "GET",
        "path": "/users",
        "statusCode": 200,
        "description": "List all users (Admin only)",
        "requiresAuth": true,
        "requiresRole": "Admin"
      },
      {
        "name": "Get User by ID",
        "method": "GET",
        "path": "/users/{user_id}",
        "statusCode": 200,
        "description": "Get specific user (Admin only)",
        "requiresAuth": true,
        "requiresRole": "Admin",
        "pathParameters": {
          "user_id": "string"
        }
      },
      {
        "name": "Update User",
        "method": "PUT",
        "path": "/users/{user_id}",
        "statusCode": 200,
        "description": "Update user (Admin only)",
        "requiresAuth": true,
        "requiresRole": "Admin",
        "pathParameters": {
          "user_id": "string"
        }
      },
      {
        "name": "Delete User",
        "method": "DELETE",
        "path": "/users/{user_id}",
        "statusCode": 200,
        "description": "Delete user (Admin only)",
        "requiresAuth": true,
        "requiresRole": "Admin",
        "pathParameters": {
          "user_id": "string"
        }
      }
    ],
